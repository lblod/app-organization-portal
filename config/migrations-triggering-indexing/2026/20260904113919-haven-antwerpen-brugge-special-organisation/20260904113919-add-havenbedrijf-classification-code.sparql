PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX mu:     <http://mu.semte.ch/vocabularies/core/>
PREFIX ext:    <http://mu.semte.ch/vocabularies/ext/>
PREFIX code:   <http://lblod.data.gift/vocabularies/organisatie/>
PREFIX scheme: <http://data.vlaanderen.be/id/conceptscheme/>

# DGS-631: hidden classification code for "special organisations" that must exist for
# Loket / Subsidiepunt but are not shown in the OP frontend. Same pattern as the
# "Agentschap Binnenlands Bestuur" code (52cc9d8d-...): the code is deliberately NOT added
# to the frontend's CLASSIFICATION list, so organisations carrying it disappear from the
# organisation list, but it IS in the "Public OP Export" scheme so the data keeps flowing
# to Loket, Subsidiepunt and the other internal consumers.
INSERT DATA {
  GRAPH <http://mu.semte.ch/graphs/public> {
    <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/ac350c36-77bb-47e8-8699-b313ca7da32a>
      rdf:type code:BestuurseenheidClassificatieCode , ext:OrganizationClassificationCode ;
      mu:uuid "ac350c36-77bb-47e8-8699-b313ca7da32a" ;
      skos:prefLabel "Havenbedrijf" ;
      skos:definition "Havenbedrijf in de zin van het Havendecreet (naamloze vennootschap van publiek recht). Speciale organisatie: niet getoond in het Organisatieportaal, wel aangeboden aan Loket en Subsidiepunt." ;
      skos:topConceptOf scheme:BestuurseenheidClassificatieCode ;
      skos:inScheme scheme:BestuurseenheidClassificatieCode , <http://lblod.data.gift/concept-schemes/10caf4a4-1ff5-4c05-917e-56489910d68b> .
  }
}
