PREFIX org: <http://www.w3.org/ns/org#>

# OP-3953: delete the generic "gerelateerd" memberships that have no successor in the
# new codelist. Rows between a Provincie and a Gemeente or OCMW are kept: the hierarchy
# cleanup jobs and the AGB creation form derive the Provincie from them.
# Worship memberships are in another graph and untouched.

DELETE {
  GRAPH ?graph { ?membership ?p ?o . }
}
WHERE {
  VALUES ?graph { <http://mu.semte.ch/graphs/administrative-unit> <http://mu.semte.ch/graphs/shared> }
  GRAPH ?graph {
    ?membership a org:Membership ;
      org:role <http://data.lblod.info/id/rollen/4ec7d5c39bdc4e84b4174379b9e22ad8> ;
      org:member ?member ;
      org:organization ?organization ;
      ?p ?o .
  }
  GRAPH ?memberGraph { ?member org:classification ?memberClass . }
  GRAPH ?organizationGraph { ?organization org:classification ?organizationClass . }
  FILTER NOT EXISTS {
    VALUES (?keptClassA ?keptClassB) {
      ( <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000000>
        <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000001> ) # Provincie, Gemeente
      ( <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000000>
        <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000002> ) # Provincie, OCMW
    }
    FILTER ( (?organizationClass = ?keptClassA && ?memberClass = ?keptClassB)
          || (?organizationClass = ?keptClassB && ?memberClass = ?keptClassA) )
  }
}
