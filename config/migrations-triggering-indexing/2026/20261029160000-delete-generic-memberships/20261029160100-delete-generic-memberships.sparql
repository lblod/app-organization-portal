PREFIX org: <http://www.w3.org/ns/org#>

# OP-3953: delete the generic "gerelateerd" memberships of non-worship organizations,
# their memberDuring links included. Worship memberships are in another graph and stay.

DELETE {
  GRAPH ?tripleGraph { ?membership ?predicate ?object . }
}
WHERE {
  VALUES ?membershipGraph { <http://mu.semte.ch/graphs/administrative-unit> <http://mu.semte.ch/graphs/shared> }
  GRAPH ?membershipGraph {
    ?membership a org:Membership ;
      org:role <http://data.lblod.info/id/rollen/4ec7d5c39bdc4e84b4174379b9e22ad8> .
  }
  VALUES ?tripleGraph { <http://mu.semte.ch/graphs/administrative-unit> <http://mu.semte.ch/graphs/shared> }
  GRAPH ?tripleGraph { ?membership ?predicate ?object . }
}
