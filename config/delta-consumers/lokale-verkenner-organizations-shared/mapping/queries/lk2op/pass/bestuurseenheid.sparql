PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX regorg: <http://www.w3.org/ns/regorg#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX rechtsvorm: <https://data.vlaanderen.be/ns/organisatie#>
PREFIX dcterms: <http://purl.org/dc/terms/>

# Units in shared, as OP's shared graph holds them today: the identity and classification
# fields other applications read to resolve and label a unit, not the editable surface
# (that stays in administrative-unit). Covers every unit, not only those in a membership.
CONSTRUCT {
  ?s ?p ?o.
} WHERE {
  ?s a besluit:Bestuurseenheid ;
    ?p ?o.

  VALUES ?p {
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
    mu:uuid
    skos:prefLabel
    skos:altLabel
    regorg:legalName
    regorg:orgStatus
    rechtsvorm:rechtsvorm
    org:classification
    org:hasSubOrganization
  }

  # rdf:type carries only the class and dcterms:Agent, as OP's shared graph does.
  FILTER (?p != <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> || ?o IN (besluit:Bestuurseenheid, dcterms:Agent))
}
