PREFIX org: <http://www.w3.org/ns/org#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX m8g: <http://data.europa.eu/m8g/>

# Organization-to-organization memberships, edited via related organizations. The export
# publishes no person memberships, so the members are always organizations.
#
# The identity and classification fields of the member and its organization are not repeated
# here: bestuurseenheid.sparql writes them for every unit, members included.
CONSTRUCT {
  ?s ?p ?o.
} WHERE {
  ?s a org:Membership ;
    ?p ?o.

  VALUES ?p {
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
    mu:uuid
    org:member
    org:organization
    org:organisation
    org:role
    m8g:memberDuring
  }
}
