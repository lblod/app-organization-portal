PREFIX regorg: <http://www.w3.org/ns/regorg#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX dcterms: <http://purl.org/dc/terms/>

# Registered organizations in shared: identity and name, as OP's shared graph holds them.
CONSTRUCT {
  ?s ?p ?o.
} WHERE {
  ?s a regorg:RegisteredOrganization ;
    ?p ?o.

  VALUES ?p {
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
    mu:uuid
    skos:prefLabel
    skos:altLabel
    regorg:legalName
  }

  FILTER (?p != <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> || ?o IN (regorg:RegisteredOrganization, dcterms:Agent))
}
