PREFIX generiek: <https://data.vlaanderen.be/ns/generiek#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>

# The structured part of an identifier. Properties per Task 1's export. Lokale Verkenner's export lists
# this class under its singular `gestructureerdeIdentificator` base.
CONSTRUCT {
  ?s ?p ?o.
} WHERE {
  ?s a generiek:GestructureerdeIdentificator ;
    ?p ?o.

  VALUES ?p {
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
    mu:uuid
    generiek:lokaleIdentificator
  }
}
