PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geosparql: <http://www.opengis.net/ont/geosparql#>
PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>

# Werkingsgebied locations a unit points at (besluit:werkingsgebied). Lokale Verkenner publishes only the
# composed ones (dcterms:creator is scope-of-operation), so the base set (gemeenten, provincies,
# regio's) never arrives from Lokale Verkenner; it stays OP's. dcterms:creator is not carried: it is Lokale Verkenner's
# bookkeeping, not data, so the ?p list leaves it out. Properties per Task 1's export.
CONSTRUCT {
  ?s ?p ?o.
} WHERE {
  ?org besluit:werkingsgebied ?s .

  ?s a prov:Location ;
    ?p ?o.

  VALUES ?p {
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
    mu:uuid
    rdfs:label
    geosparql:sfWithin
    ext:werkingsgebiedNiveau
    skos:exactMatch
  }
}
