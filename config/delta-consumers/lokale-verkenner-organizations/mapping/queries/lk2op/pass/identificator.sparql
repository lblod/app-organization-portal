PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX generiek: <https://data.vlaanderen.be/ns/generiek#>

# Identifiers of units and registered organizations, reached from either. A structured
# identifier is a companion subject (its own query). Properties per Task 1's export.
CONSTRUCT {
  ?s ?p ?o.
} WHERE {
  { ?org adms:identifier ?s }

  ?s a adms:Identifier ;
    ?p ?o.

  VALUES ?p {
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>
    mu:uuid
    skos:notation
    generiek:gestructureerdeIdentificator
  }
}
