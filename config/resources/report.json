{
    "version": "0.1",
    "prefixes": {
        "dct": "http://purl.org/dc/terms/",
        "prov": "http://www.w3.org/ns/prov#"
    },
    "resources": {
        "reports": {
            "name": "report",
            "class": "http://lblod.data.gift/vocabularies/reporting/Report",
            "attributes": {
                "created": {
                    "type": "datetime",
                    "predicate": "dct:created"
                },
                "title": {
                    "type": "string",
                    "predicate": "dct:title"
                },
                "description": {
                    "type": "string",
                    "predicate": "dct:description"
                }
            },
            "relationships": {
                "file": {
                    "predicate": "prov:generated",
                    "target": "file",
                    "cardinality": "one"
                },
                "report-spec": {
                    "predicate": "dct:conformsTo",
                    "target": "report-specs",
                    "cardinality": "one"
                },
                "creator": {
                    "predicate": "prov:wasAttributedTo",
                    "target": "chat-agents",
                    "cardinality": "one"
                }
            },
            "features": ["include-uri"],
             "new-resource-base": "http://data.lblod.info/id/reports/"
        },
        "report-specs": {
            "class": "http://lblod.data.gift/vocabularies/reporting/ReportSpec",
            "attributes": {
                "created": {
                    "type": "datetime",
                    "predicate": "dct:created"
                },
                "title": {
                    "type": "string",
                    "predicate": "dct:title"
                },
                "description": {
                    "type": "string",
                    "predicate": "dct:description"
                }
            },
            "relationships": {
                "file": {
                    "predicate": "prov:generated",
                    "target": "file",
                    "cardinality": "one"
                },
                "conversation": {
                    "predicate": "dct:isPartOf",
                    "target": "chat-conversation",
                    "cardinality": "one"
                },
                "reports": {
                    "predicate": "dct:conformsTo",
                    "target": "report",
                    "cardinality": "many",
                    "inverse": true
                },
                "creator": {
                    "predicate": "prov:wasAttributedTo",
                    "target": "chat-agents",
                    "cardinality": "one"
                }
            },
            "features": ["include-uri"],
            "new-resource-base": "http://data.lblod.info/id/report-specs/"
        }
    }
}
