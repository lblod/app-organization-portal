# Profiel "Organisaties": organisaties (incl. bestuurseenheden en
# geregistreerde organisaties), vestigingen, adressen, contacten,
# identificatoren, werkingsgebieden, KBO-gegevens, lidmaatschappen en
# veranderingsgebeurtenissen.
#
# Bron: config/resources/domain.json is de autoriteit (organizations,
# administrative-units, registered-organizations, kbo-organizations,
# sites, addresses, contact-points, identifiers, locations, memberships,
# concepts, sectors, nace-bel-codes en de classificatie- en statuscodes),
# aangevuld met config/resources/change-events.json (change-events,
# change-event-results, change-event-types, decisions,
# decision-activities).
#
# Datatypes volgen de resource-config (number → xsd:decimal,
# datetime → xsd:dateTime, date → xsd:date, boolean → xsd:boolean).
# De triplestore stond niet aan tijdens het opstellen; waar de data afwijkt
# wint later de data.
#
# Niet opgenomen (geen rapportvelden): sync- en harvest-velden
# (prov:wasGeneratedBy, owl:sameAs, task:modifiedOn, task:modifiedBy,
# rdfs:seeAlso), vendor-relaties (muAccount:canActOnBehalfOf,
# prov:wasAssociatedWith). De eredienst-tak van het organigram staat in
# erediensten.ttl; de bestuursorgaan-/mandaatketen in mandaten.ttl.
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix regorg:  <http://www.w3.org/ns/regorg#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix ere:     <http://data.lblod.info/vocabularies/erediensten/> .
@prefix locn:    <http://www.w3.org/ns/locn#> .
@prefix adres:   <https://data.vlaanderen.be/ns/adres#> .
@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <http://schema.org/> .
@prefix organisatie: <https://data.vlaanderen.be/ns/organisatie#> .
@prefix generiek: <https://data.vlaanderen.be/ns/generiek#> .
@prefix lblodgeneriek: <https://data.lblod.info/vocabularies/generiek/> .
@prefix code:    <http://lblod.data.gift/vocabularies/organisatie/> .
@prefix ext:     <http://mu.semte.ch/vocabularies/ext/> .
@prefix ch:      <http://data.lblod.info/vocabularies/contacthub/> .
@prefix nacebel: <http://data.gift/vocabularies/nace-bel/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix m8g:     <http://data.europa.eu/m8g/> .
@prefix besluit: <http://data.vlaanderen.be/ns/besluit#> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .
@prefix besluitvorming: <https://data.vlaanderen.be/ns/besluitvorming#> .
@prefix dossier: <https://data.vlaanderen.be/ns/dossier#> .
@prefix ent:     <http://data.lblod.info/id/report-entities/> .

<http://data.lblod.info/id/report-profiles/organisaties>
  a owl:Ontology ;
  dct:title "Organisaties" ;
  sh:prefixes [
    sh:declare [ sh:prefix "org"      ; sh:namespace "http://www.w3.org/ns/org#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "besluit"  ; sh:namespace "http://data.vlaanderen.be/ns/besluit#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "regorg"   ; sh:namespace "http://www.w3.org/ns/regorg#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "skos"     ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "dct"      ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "locn"     ; sh:namespace "http://www.w3.org/ns/locn#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "adres"    ; sh:namespace "https://data.vlaanderen.be/ns/adres#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "adms"     ; sh:namespace "http://www.w3.org/ns/adms#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "prov"     ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "schema"   ; sh:namespace "http://schema.org/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "organisatie" ; sh:namespace "https://data.vlaanderen.be/ns/organisatie#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "generiek" ; sh:namespace "https://data.vlaanderen.be/ns/generiek#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "lblodgeneriek" ; sh:namespace "https://data.lblod.info/vocabularies/generiek/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "code"     ; sh:namespace "http://lblod.data.gift/vocabularies/organisatie/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "ext"      ; sh:namespace "http://mu.semte.ch/vocabularies/ext/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "ch"       ; sh:namespace "http://data.lblod.info/vocabularies/contacthub/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "ere"      ; sh:namespace "http://data.lblod.info/vocabularies/erediensten/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "foaf"     ; sh:namespace "http://xmlns.com/foaf/0.1/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "geo"      ; sh:namespace "http://www.opengis.net/ont/geosparql#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "nacebel"  ; sh:namespace "http://data.gift/vocabularies/nace-bel/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "m8g"      ; sh:namespace "http://data.europa.eu/m8g/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "eli"      ; sh:namespace "http://data.europa.eu/eli/ontology#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "besluitvorming" ; sh:namespace "https://data.vlaanderen.be/ns/besluitvorming#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "dossier"  ; sh:namespace "https://data.vlaanderen.be/ns/dossier#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdfs"     ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "xsd"      ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ;
  ] .

ent:Organisatie
  a sh:NodeShape ;
  rdfs:label "organisatie" ;
  sh:targetClass org:Organization ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:description "Officiële naam van de organisatie" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path skos:altLabel ; sh:name "andere naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path regorg:legalName ; sh:name "juridische naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path lblodgeneriek:geplandeEindDatum ; sh:name "geplande einddatum" ;
                sh:description "Geplande einddatum van de organisatie (fusies)" ;
                sh:datatype xsd:date ] ;
  sh:property [ sh:path org:purpose ; sh:name "doel" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path org:classification ; sh:name "soort organisatie" ;
                sh:node ent:OrganisatieClassificatie ] ;
  sh:property [ sh:path organisatie:rechtsvorm ; sh:name "rechtsvorm" ;
                sh:node ent:Concept ] ;
  sh:property [ sh:path code:inhoudelijkThema ; sh:name "inhoudelijk thema" ;
                sh:node ent:Concept ] ;
  sh:property [ sh:path code:bijkomendeKwalificatie ; sh:name "bijkomende kwalificatie" ;
                sh:node ent:BijkomendeKwalificatie ] ;
  sh:property [ sh:path adms:identifier ; sh:name "identificator" ;
                sh:description "Identificatoren van de organisatie, bv. het KBO-nummer zit in de notatie" ;
                sh:node ent:Identificator ] ;
  sh:property [ sh:path regorg:orgStatus ; sh:name "organisatiestatus" ;
                sh:description "Bv. Actief, In oprichting" ;
                sh:node ent:OrganisatieStatus ] ;
  sh:property [ sh:path org:hasPrimarySite ; sh:name "hoofdvestiging" ;
                sh:node ent:Vestiging ] ;
  sh:property [ sh:path org:hasSite ; sh:name "vestiging" ;
                sh:node ent:Vestiging ] ;
  sh:property [ sh:path [ sh:inversePath org:member ] ; sh:name "is lid via" ;
                sh:description "De lidmaatschappen waarin deze organisatie het lid is" ;
                sh:node ent:Lidmaatschap ] ;
  sh:property [ sh:path [ sh:inversePath org:organization ] ; sh:name "bevat lidmaatschappen" ;
                sh:description "De lidmaatschappen die bij deze organisatie horen" ;
                sh:node ent:Lidmaatschap ] ;
  sh:property [ sh:path dct:isPartOf ; sh:name "sector" ;
                sh:node ent:Sector ] ;
  sh:property [ sh:path regorg:orgActivity ; sh:name "activiteit" ;
                sh:description "NaceBel-activiteit van de organisatie" ;
                sh:node ent:NaceBelCode ] ;
  sh:property [ sh:path [ sh:inversePath owl:sameAs ] ; sh:name "kbo-organisatie" ;
                sh:description "De KBO-gegevens die met deze organisatie gelijkgesteld zijn" ;
                sh:node ent:KboOrganisatie ] ;
  sh:property [ sh:path [ sh:inversePath org:originalOrganization ] ; sh:name "veranderd door" ;
                sh:description "De veranderingsgebeurtenis waarvan deze organisatie het oorspronkelijke bestuur is" ;
                sh:node ent:Veranderingsgebeurtenis ] ;
  sh:property [ sh:path [ sh:inversePath org:resultingOrganization ] ; sh:name "resulteerde uit" ;
                sh:description "De veranderingsgebeurtenis waaruit deze organisatie is voortgekomen" ;
                sh:node ent:Veranderingsgebeurtenis ] ;
  sh:property [ sh:path [ sh:inversePath ext:resultingOrganization ] ; sh:name "veranderingsresultaat van" ;
                sh:description "De veranderingsresultaten die naar deze organisatie wijzen" ;
                sh:node ent:VeranderingsgebeurtenisResultaat ] .

ent:Bestuurseenheid
  a sh:NodeShape ;
  rdfs:label "bestuurseenheid" ;
  sh:targetClass besluit:Bestuurseenheid ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:description "Officiële naam van de bestuurseenheid" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path skos:altLabel ; sh:name "andere naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path regorg:legalName ; sh:name "juridische naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path lblodgeneriek:geplandeEindDatum ; sh:name "geplande einddatum" ;
                sh:description "Geplande einddatum van de bestuurseenheid (fusies)" ;
                sh:datatype xsd:date ] ;
  sh:property [ sh:path org:purpose ; sh:name "doel" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path org:classification ; sh:name "soort bestuur" ;
                sh:description "Classificatie: gemeente, OCMW, provincie, ..." ;
                sh:node ent:BestuurseenheidClassificatie ] ;
  sh:property [ sh:path organisatie:rechtsvorm ; sh:name "rechtsvorm" ;
                sh:node ent:Concept ] ;
  sh:property [ sh:path code:inhoudelijkThema ; sh:name "inhoudelijk thema" ;
                sh:node ent:Concept ] ;
  sh:property [ sh:path code:bijkomendeKwalificatie ; sh:name "bijkomende kwalificatie" ;
                sh:node ent:BijkomendeKwalificatie ] ;
  sh:property [ sh:path adms:identifier ; sh:name "identificator" ;
                sh:description "Identificatoren van de bestuurseenheid, bv. het KBO-nummer zit in de notatie" ;
                sh:node ent:Identificator ] ;
  sh:property [ sh:path regorg:orgStatus ; sh:name "organisatiestatus" ;
                sh:node ent:OrganisatieStatus ] ;
  sh:property [ sh:path org:hasPrimarySite ; sh:name "hoofdvestiging" ;
                sh:node ent:Vestiging ] ;
  sh:property [ sh:path org:hasSite ; sh:name "vestiging" ;
                sh:node ent:Vestiging ] ;
  sh:property [ sh:path besluit:werkingsgebied ; sh:name "werkingsgebied" ;
                sh:description "Het territorium waar de bestuurseenheid over gaat" ;
                sh:node ent:Werkingsgebied ] ;
  sh:property [ sh:path geo:sfWithin ; sh:name "ligt in" ;
                sh:description "Het gebied waar de bestuurseenheid in ligt" ;
                sh:node ent:Werkingsgebied ] ;
  sh:property [ sh:path skos:exactMatch ; sh:name "exacte match" ;
                sh:node ent:Concept ] ;
  sh:property [ sh:path [ sh:inversePath org:member ] ; sh:name "is lid via" ;
                sh:node ent:Lidmaatschap ] ;
  sh:property [ sh:path [ sh:inversePath org:organization ] ; sh:name "bevat lidmaatschappen" ;
                sh:node ent:Lidmaatschap ] ;
  sh:property [ sh:path dct:isPartOf ; sh:name "sector" ;
                sh:node ent:Sector ] ;
  sh:property [ sh:path regorg:orgActivity ; sh:name "activiteit" ;
                sh:node ent:NaceBelCode ] ;
  sh:property [ sh:path [ sh:inversePath owl:sameAs ] ; sh:name "kbo-organisatie" ;
                sh:node ent:KboOrganisatie ] ;
  sh:property [ sh:path [ sh:inversePath org:originalOrganization ] ; sh:name "veranderd door" ;
                sh:node ent:Veranderingsgebeurtenis ] ;
  sh:property [ sh:path [ sh:inversePath org:resultingOrganization ] ; sh:name "resulteerde uit" ;
                sh:node ent:Veranderingsgebeurtenis ] ;
  sh:property [ sh:path [ sh:inversePath ext:resultingOrganization ] ; sh:name "veranderingsresultaat van" ;
                sh:node ent:VeranderingsgebeurtenisResultaat ] .

ent:GeregistreerdeOrganisatie
  a sh:NodeShape ;
  rdfs:label "geregistreerde organisatie" ;
  sh:targetClass regorg:RegisteredOrganization ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path skos:altLabel ; sh:name "andere naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path regorg:legalName ; sh:name "juridische naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path lblodgeneriek:geplandeEindDatum ; sh:name "geplande einddatum" ;
                sh:datatype xsd:date ] ;
  sh:property [ sh:path org:purpose ; sh:name "doel" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path org:classification ; sh:name "soort organisatie" ;
                sh:node ent:GeregistreerdeOrganisatieClassificatie ] ;
  sh:property [ sh:path organisatie:rechtsvorm ; sh:name "rechtsvorm" ;
                sh:node ent:Concept ] ;
  sh:property [ sh:path code:inhoudelijkThema ; sh:name "inhoudelijk thema" ;
                sh:node ent:Concept ] ;
  sh:property [ sh:path code:bijkomendeKwalificatie ; sh:name "bijkomende kwalificatie" ;
                sh:node ent:BijkomendeKwalificatie ] ;
  sh:property [ sh:path adms:identifier ; sh:name "identificator" ;
                sh:node ent:Identificator ] ;
  sh:property [ sh:path regorg:orgStatus ; sh:name "organisatiestatus" ;
                sh:node ent:OrganisatieStatus ] ;
  sh:property [ sh:path org:hasPrimarySite ; sh:name "hoofdvestiging" ;
                sh:node ent:Vestiging ] ;
  sh:property [ sh:path org:hasSite ; sh:name "vestiging" ;
                sh:node ent:Vestiging ] ;
  sh:property [ sh:path dct:spatial ; sh:name "werkingsgebied" ;
                sh:node ent:Werkingsgebied ] ;
  sh:property [ sh:path [ sh:inversePath org:member ] ; sh:name "is lid via" ;
                sh:node ent:Lidmaatschap ] ;
  sh:property [ sh:path [ sh:inversePath org:organization ] ; sh:name "bevat lidmaatschappen" ;
                sh:node ent:Lidmaatschap ] ;
  sh:property [ sh:path dct:isPartOf ; sh:name "sector" ;
                sh:node ent:Sector ] ;
  sh:property [ sh:path regorg:orgActivity ; sh:name "activiteit" ;
                sh:node ent:NaceBelCode ] ;
  sh:property [ sh:path [ sh:inversePath owl:sameAs ] ; sh:name "kbo-organisatie" ;
                sh:node ent:KboOrganisatie ] .

ent:KboOrganisatie
  a sh:NodeShape ;
  rdfs:label "kbo-organisatie" ;
  sh:targetClass ext:KboOrganisatie ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path ext:rechtsvorm ; sh:name "rechtsvorm" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path ext:startDate ; sh:name "startdatum" ;
                sh:datatype xsd:date ] ;
  sh:property [ sh:path dct:modified ; sh:name "gewijzigd" ;
                sh:datatype xsd:date ] ;
  sh:property [ sh:path owl:sameAs ; sh:name "organisatie" ;
                sh:description "De organisatie in dit portaal die aan dit KBO-record gekoppeld is" ;
                sh:node ent:Organisatie ] .

ent:OrganisatieClassificatie
  a sh:NodeShape ;
  rdfs:label "organisatieclassificatie" ;
  sh:targetClass ext:OrganizationClassificationCode ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path skos:altLabel ; sh:name "andere naam" ;
                sh:datatype xsd:string ] .

ent:BestuurseenheidClassificatie
  a sh:NodeShape ;
  rdfs:label "soort bestuur" ;
  sh:targetClass code:BestuurseenheidClassificatieCode ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path skos:altLabel ; sh:name "andere naam" ;
                sh:datatype xsd:string ] .

ent:GeregistreerdeOrganisatieClassificatie
  a sh:NodeShape ;
  rdfs:label "soort geregistreerde organisatie" ;
  sh:targetClass ext:GeregistreerdeOrganisatieClassificatieCode ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path skos:altLabel ; sh:name "andere naam" ;
                sh:datatype xsd:string ] .

ent:OrganisatieStatus
  a sh:NodeShape ;
  rdfs:label "organisatiestatus" ;
  sh:targetClass code:OrganisatieStatusCode ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:datatype xsd:string ] .

ent:Vestiging
  a sh:NodeShape ;
  rdfs:label "vestiging" ;
  sh:targetClass org:Site ;
  sh:property [ sh:path dct:description ; sh:name "omschrijving" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path ere:vestigingstype ; sh:name "type vestiging" ;
                sh:node ent:TypeVestiging ] ;
  sh:property [ sh:path organisatie:bestaatUit ; sh:name "adres" ;
                sh:node ent:Adres ] ;
  sh:property [ sh:path org:siteAddress ; sh:name "contact" ;
                sh:node ent:ContactPunt ] ;
  sh:property [ sh:path [ sh:inversePath org:hasPrimarySite ] ; sh:name "hoofdvestiging van" ;
                sh:node ent:Organisatie ] ;
  sh:property [ sh:path [ sh:inversePath org:hasSite ] ; sh:name "vestiging van" ;
                sh:node ent:Organisatie ] .

ent:TypeVestiging
  a sh:NodeShape ;
  rdfs:label "type vestiging" ;
  sh:targetClass code:TypeVestiging ;
  sh:property [ sh:path skos:prefLabel ; sh:name "naam" ;
                sh:datatype xsd:string ] .

ent:Adres
  a sh:NodeShape ;
  rdfs:label "adres" ;
  sh:targetClass locn:Address ;
  sh:property [ sh:path locn:thoroughfare ; sh:name "straat" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path adres:Adresvoorstelling.huisnummer ; sh:name "huisnummer" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path adres:Adresvoorstelling.busnummer ; sh:name "busnummer" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path locn:postCode ; sh:name "postcode" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path adres:gemeentenaam ; sh:name "gemeente" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path locn:adminUnitL2 ; sh:name "provincie" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path adres:land ; sh:name "land" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path locn:fullAddress ; sh:name "volledig adres" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path adres:verwijstNaar ; sh:name "verwijst naar" ;
                sh:description "URI van het adres in het adressenregister" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path [ sh:inversePath organisatie:bestaatUit ] ; sh:name "vestiging van" ;
                sh:node ent:Vestiging ] .

ent:ContactPunt
  a sh:NodeShape ;
  rdfs:label "contactpunt" ;
  sh:targetClass schema:ContactPoint ;
  sh:property [ sh:path schema:email ; sh:name "email" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path schema:telephone ; sh:name "telefoon" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path schema:faxNumber ; sh:name "fax" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path foaf:page ; sh:name "website" ;
                sh:description "URI van de website" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path schema:contactType ; sh:name "contactsoort" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path locn:address ; sh:name "adres" ;
                sh:node ent:Adres ] .

ent:Identificator
  a sh:NodeShape ;
  rdfs:label "identificator" ;
  sh:targetClass adms:Identifier ;
  sh:property [ sh:path skos:notation ; sh:name "notatie" ;
                sh:description "De waarde van de identificator, bv. het KBO-nummer" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path generiek:gestructureerdeIdentificator ; sh:name "gestructureerde identificator" ;
                sh:node ent:GestructureerdeIdentificator ] .

ent:GestructureerdeIdentificator
  a sh:NodeShape ;
  rdfs:label "gestructureerde identificator" ;
  sh:targetClass generiek:GestructureerdeIdentificator ;
  sh:property [ sh:path generiek:lokaleIdentificator ; sh:name "lokale identificator" ;
                sh:datatype xsd:string ] .

ent:Werkingsgebied
  a sh:NodeShape ;
  rdfs:label "werkingsgebied" ;
  sh:targetClass prov:Location ;
  sh:property [ sh:path rdfs:label ; sh:name "naam" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path ext:werkingsgebiedNiveau ; sh:name "niveau" ;
                sh:datatype xsd:string ] ;
  sh:property [ sh:path geo:sfWithin ; sh:name "ligt in" ;
                sh:node ent:Werkingsgebied ] ;
  sh:property [ sh:path [ sh:inversePath geo:sfWithin ] ; sh:name "bevat" ;
                sh:description "De gebieden en de bestuurseenheden die in dit gebied liggen" ;
                sh:or ( [ sh:node ent:Werkingsgebied ] [ sh:node ent:Bestuurseenheid ] ) ] ;
  sh:property [ sh:path skos:exactMatch ; sh:name "exacte match" ;
                sh:node ent:Concept ] .

ent:Concept
  a sh:NodeShape ;
  rdfs:label "concept" ;
  sh:targetClass skos:Concept ;
