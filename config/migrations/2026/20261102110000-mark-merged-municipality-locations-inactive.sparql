# Mark the municipality locations (werkingsgebieden) that ceased to exist
# through mergers as inactive. Locations without an ext:inactive triple are
# considered active. The frontend filters location pickers with
# `filter[:has-no:inactive]` so these no longer show up.

PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX prov: <http://www.w3.org/ns/prov#>

INSERT {
  GRAPH ?g {
    ?location ext:inactive true .
  }
} WHERE {
  GRAPH ?g {
    ?location a prov:Location .

    VALUES ?location {
      <http://data.lblod.info/id/werkingsgebieden/7a7daa48e9e6449358cf96be6c7b30466648d31236e56b8958fae7d53e2308b8> # Aalter (voor fusie)
