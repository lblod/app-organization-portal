@prefix cleanup: <http://mu.semte.ch/vocabularies/ext/cleanup/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Insert triples of the form
# <Municipality> <http://www.w3.org/ns/org#hasSubOrganization> <zone>
# for "participant" memberships (gemeente is lid van zone) for which no such triple exists.
# Counterpart of the "gerelateerd"-based insert job 3b7f8739-aa56-4a6c-af56-eb9d80022379;
# the delete job 141a5f1c-39d5-431a-99e2-9085252654a3 knows both patterns.
# Municipality: <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000001>
#
# HVZ: <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/ea446861-2c51-45fa-afd3-4e4a37b71562>
# PZ: <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/a3922c6d-425b-474f-9a02-ffb71a436bfc>

<http://data.lblod.info/id/cleanup-job/2e1b9cd2-bd0e-4baa-a103-b58e50e60594> a cleanup:Job ;
    mu:uuid "2e1b9cd2-bd0e-4baa-a103-b58e50e60594" ;
    dcterms:title "Insert missing `org:hasSubOrganization` triples for Municipalities that are members of police and assistance zones." ;
    cleanup:randomQuery """
      PREFIX org: <http://www.w3.org/ns/org#>
      INSERT {
        GRAPH <http://mu.semte.ch/graphs/administrative-unit> {
          ?municipality org:hasSubOrganization ?zone .
        }
      } WHERE {
        GRAPH <http://mu.semte.ch/graphs/administrative-unit> {
          ?membership a org:Membership ;
            org:member ?municipality ;
            org:organization ?zone ;
            org:role <http://data.lblod.info/id/rollen/2152eb830b1143bfb97a7dd9596d6c63> .
          FILTER NOT EXISTS { ?municipality org:hasSubOrganization ?zone . }
          ?zone org:classification ?zoneClass .
          FILTER ( ?zoneClass
                   IN (
                      <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/ea446861-2c51-45fa-afd3-4e4a37b71562> ,
                      <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/a3922c6d-425b-474f-9a02-ffb71a436bfc>
                    )
               )
        }
        GRAPH <http://mu.semte.ch/graphs/shared> {
          ?municipality org:classification <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000001> .
        }
      }
    """ .
