PREFIX ere: <http://data.lblod.info/vocabularies/erediensten/>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX org: <http://www.w3.org/ns/org#>

# Deduplicate islamitisch minister positions: if an eredienstbestuur has more
# than one position for the same function (e.g. 2 "Waarnemende Imam"), keep
# only one - deterministically the lowest-URI position - and drop the rest
DELETE {
    GRAPH <http://mu.semte.ch/graphs/worship-service> {
        ?worshipService ere:wordtBediendDoor ?position .
        ?position ?p ?o .
    }
}
WHERE {
    GRAPH <http://mu.semte.ch/graphs/worship-service> {
        ?worshipService a ere:BestuurVanDeEredienst ;
        ere:typeEredienst <http://lblod.data.gift/concepts/9d8bd472a00bf0a5c7b7186606365a52> ; # Islamitisch
        ere:wordtBediendDoor ?position .

        ?position ?p ?o ;
        ere:functie ?functie .

        {
            SELECT ?worshipService ?functie (IRI(MIN(STR(?anyPosition))) AS ?keptPosition) WHERE {
                GRAPH <http://mu.semte.ch/graphs/worship-service> {
                    ?worshipService ere:wordtBediendDoor ?anyPosition .
                    ?anyPosition ere:functie ?functie .
                }
            }
            GROUP BY ?worshipService ?functie
        }

        FILTER(?position != ?keptPosition)
    }
}
;

# Create any of the 4 islamitisch minister positions (Waarnemende Imam, Eerste/
# Tweede/Derde Imam in rang) that a worship service is missing, so every
# islamitisch eredienstbestuur always has all 4 positions, regardless of its
# current status.
INSERT {
    GRAPH <http://mu.semte.ch/graphs/worship-service> {
        ?worshipService ere:wordtBediendDoor ?newMinisterPosition .

        ?newMinisterPosition a org:Post , ere:PositieBedienaar ;
        mu:uuid ?uuidNewMinisterPosition ;
        ere:functie ?functie .
    }
}
WHERE {
    GRAPH <http://mu.semte.ch/graphs/worship-service> {
        ?worshipService a ere:BestuurVanDeEredienst ;
        ere:typeEredienst <http://lblod.data.gift/concepts/9d8bd472a00bf0a5c7b7186606365a52> . # Islamitisch

        VALUES ?functie {
            <http://lblod.data.gift/concepts/7d8e0c15-7726-4196-9416-6dc40ed858bb> # Waarnemende Imam
            <http://lblod.data.gift/concepts/e357bc8f4cc3a694fde2239748768a22> # Eerste Imam in rang
            <http://lblod.data.gift/concepts/c4a3fd586211b17b06f574885e23f355> # Tweede Imam in rang
            <http://lblod.data.gift/concepts/5ebb798bd59c3b48c25116032caa02b7> # Derde Imam in rang
        }

        FILTER NOT EXISTS {
            ?worshipService ere:wordtBediendDoor ?ministerPosition .
            ?ministerPosition ere:functie ?functie .
        }

        BIND(MD5(CONCAT(?worshipService, ?functie)) as ?uuidNewMinisterPosition)
        BIND(IRI(CONCAT("http://data.lblod.info/id/positiesBedienaar/", ?uuidNewMinisterPosition)) AS ?newMinisterPosition)
    }
}
