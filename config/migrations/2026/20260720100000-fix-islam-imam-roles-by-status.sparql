PREFIX ere: <http://data.lblod.info/vocabularies/erediensten/>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX regorg: <http://www.w3.org/ns/regorg#>

# Deduplicate islamitisch minister positions: if an eredienstbestuur has more
# than one position for the same function (e.g. 2 "Waarnemende Imam"), keep
# only one - deterministically the lowest-URI position - and merge the rest
# into it: any minister (org:holds) on a non-kept position is reparented onto
# the kept position instead of being dropped. Ministers and their conditions
# (ere:voldoetAan) are left fully intact, just re-pointed to survive the dedup.
DELETE {
  GRAPH <http://mu.semte.ch/graphs/worship-service> {
    ?minister org:holds ?position .
  }
}
INSERT {
  GRAPH <http://mu.semte.ch/graphs/worship-service> {
    ?minister org:holds ?keptPosition .
  }
}
WHERE {
  GRAPH <http://mu.semte.ch/graphs/worship-service> {
    ?worshipService a ere:BestuurVanDeEredienst ;
      ere:typeEredienst <http://lblod.data.gift/concepts/9d8bd472a00bf0a5c7b7186606365a52> ; # Islamitisch
      ere:wordtBediendDoor ?position .

    ?position ere:functie ?functie .
    ?minister org:holds ?position .

    {
      SELECT ?worshipService ?functie (IRI(MIN(STR(?anyPosition))) AS ?keptPosition) WHERE {
        GRAPH <http://mu.semte.ch/graphs/worship-service> {
          ?worshipService ere:wordtBediendDoor ?anyPosition .
          ?anyPosition ere:functie ?functie .
        }
      }
      GROUP BY ?worshipService ?functie
    }

    FILTER(?position != ?keptPosition)
  }
}
;

# Delete the now-empty duplicate positions left behind by the reparenting
# above (same "lowest URI wins" rule, kept in sync with it). Since ministers
# were already moved off in the previous step, this only drops the position
# shells and their own triples (org:Post, mu:uuid, ere:functie).
DELETE {
  GRAPH <http://mu.semte.ch/graphs/worship-service> {
    ?worshipService ere:wordtBediendDoor ?position .
    ?position ?p ?o .
  }
}
WHERE {
  GRAPH <http://mu.semte.ch/graphs/worship-service> {
    ?worshipService a ere:BestuurVanDeEredienst ;
      ere:typeEredienst <http://lblod.data.gift/concepts/9d8bd472a00bf0a5c7b7186606365a52> ; # Islamitisch
      ere:wordtBediendDoor ?position .

    ?position ?p ?o ;
      ere:functie ?functie .

    {
      SELECT ?worshipService ?functie (IRI(MIN(STR(?anyPosition))) AS ?keptPosition) WHERE {
        GRAPH <http://mu.semte.ch/graphs/worship-service> {
          ?worshipService ere:wordtBediendDoor ?anyPosition .
          ?anyPosition ere:functie ?functie .
        }
      }
      GROUP BY ?worshipService ?functie
    }

    FILTER(?position != ?keptPosition)
  }
}
;

