PREFIX organisatie: <https://data.vlaanderen.be/ns/organisatie#>

DELETE {
  GRAPH ?g {
    ?organization organisatie:rechtsvorm ?legalForm .
  }
  GRAPH ?oldGraph {
    ?organization organisatie:rechtsvorm ?oldLegalForm .
  }
}
INSERT {
  GRAPH ?g {
    ?organization organisatie:rechtsvorm ?legalForm .
  }
}
WHERE {
  VALUES (?classificationCode ?legalForm) {
    (<http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000001> <http://lblod.data.gift/concepts/4a55b679-e4c7-4014-a0b8-3d6762e0225f>) # Gemeente -> Stad / gemeente
