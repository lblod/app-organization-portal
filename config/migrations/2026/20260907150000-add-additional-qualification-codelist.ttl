# Concept Scheme for Additional Qualification (Bijkomende kwalificatie)
conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3
  rdf:type skos:ConceptScheme ;
  mu:uuid "48face96-e06d-4a3e-9fc6-f625e763a0a3" ;
  skos:prefLabel "Bijkomende kwalificatie" .

concept:f877fae8-5101-4513-871c-4dd2151b0c99
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "f877fae8-5101-4513-871c-4dd2151b0c99" ;
  skos:prefLabel "Geen bijkomende kwalificatie" ;
  code:rechtsgrond "Geen rechtsgrond" ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:fb7c4b8d-6927-45ba-8f4e-f4854d437815
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "fb7c4b8d-6927-45ba-8f4e-f4854d437815" ;
  skos:prefLabel "Afvalintercommunale" ;
  code:rechtsgrond "Artikel 26 van het decreet betreffende het duurzaam beheer van materiaalkringlopen en afvalstoffen" ;
  skos:definition "Een samenwerkingsverband dat ertoe bijdraagt de huishoudelijke afvalstoffen zo veel mogelijk worden voorkomen of worden hergebruikt, op regelmatige tijdstippen worden opgehaald of op een andere wijze worden ingezameld, en nuttig worden toegepast of verwijderd, overeenkomstig artikel 11, 12 en 13 van het decreet betreffende het duurzaam beheer van materiaalkringlopen en afvalstoffen." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:7f51db9f-e934-4234-9870-fb18ed7afc16
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "7f51db9f-e934-4234-9870-fb18ed7afc16" ;
  skos:prefLabel "Bibliotheekwerking binnen IGS bovenlokale cultuurwerking" ;
  code:rechtsgrond "Artikelen 33 tot en met 39 van het Bovenlokaalcultuurdecreet van 8 maart 2024" ;
  skos:definition "Een intergemeentelijk samenwerkingsverband met rechtspersoonlijkheid dat, binnen zijn bovenlokale cultuurwerking, bibliotheken of bibliotheekdiensten als culturele actoren, praktijken of diensten samenbrengt, ondersteunt, innoveert of verduurzaamt." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:87966ef7-cc35-48c3-94b6-ffb41f65bed3
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "87966ef7-cc35-48c3-94b6-ffb41f65bed3" ;
  skos:prefLabel "Distributienetbeheerder" ;
  code:rechtsgrond "Artikel 4.1.1 van het Energiedecreet" ;
  skos:definition "Een rechtspersoon die door de Vlaamse Nutsregulator belast wordt met het beheer van het elektriciteits- en het aardgasdistributienet van een aaneensluitend geografisch afgebakend gebied." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:910dde7d-3eda-40f0-948b-ca81c7b0152d
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "910dde7d-3eda-40f0-948b-ca81c7b0152d" ;
  skos:prefLabel "Energieholding en/of -participatie" ;
  code:rechtsgrond "Artikel 180 van de Energiewet van 1994" ;
  skos:definition "Een rechtspersoon of samenwerkingsverband dat energiegerelateerde participaties of holdings aanhoudt of beheert, zonder dat dit een afzonderlijke rechtsvorm of sectorale erkenning vormt." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:f92cde87-1ae2-4278-aaa8-78ad598e04b1
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "f92cde87-1ae2-4278-aaa8-78ad598e04b1" ;
  skos:prefLabel "Energiehuis" ;
  code:rechtsgrond "Artikel 1.1.3, 40°/2 en titel IX Energiehuizen van het Energiedecreet" ;
  skos:definition "Een rechtspersoon of samenwerkingsverband die op het niveau van één of meer gemeenten diensten inzake energie en woningkwaliteit aanbiedt aan de klant en door de Vlaamse minister van Energie werd erkend." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:2980c9c5-3e7a-4114-a1bd-a51f8ae34b3c
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "2980c9c5-3e7a-4114-a1bd-a51f8ae34b3c" ;
  skos:prefLabel "IGS bovenlokaal netwerk vrijetijdsparticipatie" ;
  code:rechtsgrond "Artikelen 40 tot en met 46 van het Bovenlokaalcultuurdecreet van 8 maart 2024" ;
  skos:definition "Een samenwerkingsverband dat een werkingssubsidie werd toegekend door de Vlaamse Regering voor de organisatie van een bovenlokaal netwerk vrijetijdsparticipatie met als doel de participatiedrempels van personen in armoede bij participatie in cultuur, jeugdwerk en sport in het werkingsgebied weg te werken." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:14fc15f7-8217-4b15-8e3c-1e6dcc2570ee
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "14fc15f7-8217-4b15-8e3c-1e6dcc2570ee" ;
  skos:prefLabel "IGS bovenlokale cultuurwerking" ;
  code:rechtsgrond "Artikel 33 van het Bovenlokaalcultuurdecreet van 8 maart 2024" ;
  skos:definition "Een samenwerkingsverband dat een werkingssubsidie werd toegekend door de Vlaamse Regering voor een bovenlokale cultuurwerking om een geïntegreerde, inclusieve bovenlokale cultuurwerking in hun werkingsgebied te ontwikkelen, in stand te houden en te verspreiden." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:7a4abacb-3a15-4086-a1e3-d7e198d3ee4b
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "7a4abacb-3a15-4086-a1e3-d7e198d3ee4b" ;
  skos:prefLabel "IGS crematorium" ;
  code:rechtsgrond "Besluit van de Vlaamse Regering van 14 mei 2004 tot organisatie, inrichting en beheer van begraafplaatsen en crematoria." ;
  skos:definition "Een samenwerkingsverband dat op grond van de regelgeving over begraafplaatsen en lijkbezorging een intergemeentelijk crematorium opricht en beheert." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:59fd0892-6c97-4676-ae28-5afaee07b979
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "59fd0892-6c97-4676-ae28-5afaee07b979" ;
  skos:prefLabel "IGS cultureel-erfgoedwerking" ;
  code:rechtsgrond "Artikel 57 van het Cultureelerfgoeddecreet van 23 december 2021 en uitvoeringsbepalingen" ;
  skos:definition "Een samenwerkingsverband dat een werkingssubsidie werd toegekend door de Vlaamse Regering voor de werking van een cultureelerfgoedcel, die een initiërende, coördinerende en ondersteunende rol opneemt, en van eventuele collectiebeherende organisaties voor zover deze de dienstverlenende rol mee opnemen." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:f4a15c55-910d-40ca-be41-41aa428ca993
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "f4a15c55-910d-40ca-be41-41aa428ca993" ;
  skos:prefLabel "IGS jeugdwerk en jeugdbeleid" ;
  code:rechtsgrond "Artikel 38 van het Jeugddecreet van 23 november 2023" ;
  skos:definition "Een samenwerkingsverband dat een werkingssubsidie werd toegekend door de Vlaamse Regering voor het stimuleren van samenwerking en netwerking tussen lokale besturen over het jeugdwerk en het jeugdbeleid binnen hun werkingsgebied." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:fa245a09-bd4d-499a-9bf3-fba5f028c061
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "fa245a09-bd4d-499a-9bf3-fba5f028c061" ;
  skos:prefLabel "IGS lokaal woonbeleid" ;
  code:rechtsgrond "Artikelen 2.2., 2.11. en 2.13. van het Besluit Vlaamse Codex Wonen van 2021" ;
  skos:definition "Een intergemeentelijk samenwerkingsverband dat een subsidie werd toegekend door de Vlaamse Regering met het oog op de realisatie van de Vlaamse beleidsprioriteiten op lokaal woonbeleid, zoals: De gemeente zorgt voor een divers en betaalbaar woonaanbod afhankelijk van de woonnoden. De gemeente werkt aan de kwaliteit van het woningpatrimonium en de woonomgeving. De gemeente informeert, adviseert en begeleidt inwoners met vragen over wonen." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:2ca3f306-5167-4b05-a0cf-9650c75eb2c9
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "2ca3f306-5167-4b05-a0cf-9650c75eb2c9" ;
  skos:prefLabel "IGS regierol sociale economie en werk" ;
  code:rechtsgrond "Artikel 14 van het decreet van 22 maart 2024 over de ondersteuning van sociale economie en maatschappelijk verantwoord ondernemen" ;
  skos:definition "Een intergemeentelijk samenwerkingsverband die de lokale regierol op het vlak van sociale economie en werk opneemt." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:cf6025af-52b4-4527-8e89-7eb8c38be70d
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "cf6025af-52b4-4527-8e89-7eb8c38be70d" ;
  skos:prefLabel "IGS wijk-werken / Wijk-werken" ;
  code:rechtsgrond "Artikelen 14 en 17 van het Wijk-werkendecreet van 7 juli 2017" ;
  skos:definition "Een rechtspersoon of samenwerkingsverband die door de gemeente(n) werd aangeduid of opgericht als organisator van wijk-werken. Deze organisator is belast met de taken die omschreven worden in artikel 17 van het Wijk-werkendecreet van 7 juli 2017." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:d0e660ab-66e5-4929-a24c-a7e89fdf1a36
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "d0e660ab-66e5-4929-a24c-a7e89fdf1a36" ;
  skos:prefLabel "Intergemeentelijke onroerenderfgoeddienst IOED" ;
  code:rechtsgrond "Artikelen 2.1. en 3.3.1. van het Onroerenderfgoeddecreet" ;
  skos:definition "Een intergemeentelijk samenwerkingsverband erkend door de Vlaamse Regering dat beleidsuitvoerende taken inzake onroerend erfgoed opneemt." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:de4ba614-265a-4741-9901-655cf4b89315
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "de4ba614-265a-4741-9901-655cf4b89315" ;
  skos:prefLabel "Rioolbeheerder" ;
  code:rechtsgrond "Artikel 2.6.1.3.3 van het gecodificeerd Decreet betreffende het integraal waterbeleid" ;
  skos:definition "De gemeente, het gemeentebedrijf, de intercommunale, het intergemeentelijk samenwerkingsverband, de exploitant van een openbaar waterdistributienetwerk of een andere overeenkomstig de regelgeving aangewezen entiteit die verantwoordelijk is voor de uitvoering van de gemeentelijke saneringsverplichting" ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:6d0eb89d-921d-42fd-bb0f-ce2cd1db7cce
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "6d0eb89d-921d-42fd-bb0f-ce2cd1db7cce" ;
  skos:prefLabel "Samenwerkingsverband geïntegreerd breed onthaal" ;
  code:rechtsgrond "Artikelen 9 tot en met 11 van het decreet betreffende het lokaal sociaal beleid" ;
  skos:definition "Een samenwerkingsverband, onder regie van het lokaal bestuur, dat minstens het OCMW, het centrum voor algemeen welzijnswerk en de erkende diensten maatschappelijk werk van de ziekenfondsen omvat en dat wordt gerealiseerd vanuit het Sociaal Huis." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:dc58093c-3c2c-4b67-a23d-86868d115e1e
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "dc58093c-3c2c-4b67-a23d-86868d115e1e" ;
  skos:prefLabel "Sportregio/IGS Sportwerking" ;
  code:rechtsgrond "Geen decretale rechtsgrond" ;
  skos:definition "Een gemeentelijk of intergemeentelijk samenwerkingsverband waarin twee of meer gemeenten/steden of gelijkgestelde actoren hun sportbeleid bovenlokaal afstemmen, versterken of uitvoeren door sportpromotionele, beleidsmatige of ondersteunende projecten en activiteiten te ontwikkelen die tegemoetkomen aan behoeften van de deelnemende gemeenten/steden en effect hebben op hun gezamenlijke sportwerking." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:8d11f9bd-a485-4dce-b962-117e2c8112ef
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "8d11f9bd-a485-4dce-b962-117e2c8112ef" ;
  skos:prefLabel "Streekontwikkelingsintercommunale" ;
  code:rechtsgrond "Decreet ruimtelijke economie van 13 juli 2012" ;
  skos:definition "Een samenwerkingsverband om bovenlokale noden en kansen in een streek te ondersteunen, voorbereiden, coördineren, regisseren of realiseren via intergemeentelijke, interbestuurlijke en eventueel publiek-private samenwerking, met het oog op duurzame ruimtelijke, economische, sociale en bestuurlijke ontwikkeling van de streek, en met gebruik van sectorale instrumenten inzake onder meer ruimtelijke planning, economische ruimte, bedrijventerreinen, grondbeleid, wonen, mobiliteit, infrastructuur, energie, klimaat en maatschappelijke dienstverlening." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:83e7e9b4-4e38-45ee-a225-940a14bd541d
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "83e7e9b4-4e38-45ee-a225-940a14bd541d" ;
  skos:prefLabel "UiTPAS-regio" ;
  code:rechtsgrond "Decreet digitale transformatie cultuursector 2023" ;
  skos:definition "Een werkingsgebied van steden en/of gemeenten die zijn aangesloten bij het UiTPAS-initiatief waarin het door publiq ontwikkelde en beheerde UiTPAS-programma gezamenlijk wordt toegepast, met afspraken over het gebruik van de UiTPAS, openstelling van vrijetijdsaanbod, spaar- en omruilvoordelen, doelgroepafbakening, toepassing en verrekening van het kansentarief, en samenwerking rond vrijetijdsparticipatie; de regio wordt juridisch gedragen door de betrokken lokale besturen zelf, door een intergemeentelijke samenwerkingsovereenkomst of door een intergemeentelijk samenwerkingsverband met rechtspersoonlijkheid, en moet waar relevant voldoen aan de subsidievoorwaarden van het Bovenlokaalcultuurdecreet en de principes van regioconform samenwerken." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .

concept:55894cb9-2e5f-47b8-8aac-8681180e1f6b
  rdf:type skos:Concept , code:BijkomendeKwalificatieCode ;
  mu:uuid "55894cb9-2e5f-47b8-8aac-8681180e1f6b" ;
  skos:prefLabel "Waterbeheerder" ;
  code:rechtsgrond "Artikelen 2.1.2. en 2.3.5. van het gecodificeerd Decreet van 15 juni 2018 betreffende het integraal waterbeleid" ;
  skos:definition "Exploitant van een openbaar waterdistributienetwerk, waterleverancier, rioolbeheerder of uitvoerder van de gemeentelijke saneringsverplichting." ;
  skos:topConceptOf conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 ;
  skos:inScheme conceptscheme:48face96-e06d-4a3e-9fc6-f625e763a0a3 .
